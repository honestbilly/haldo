# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgresql://localhost:5432/haldo

# Session
SESSION_SECRET=change-me-to-a-64-char-random-string

# Email alerts (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=billy@honesteco.com
SMTP_PASS=your-gmail-app-password
MANAGER_EMAIL=billy@honesteco.com
ALERT_EMAIL_FROM=haldo@honesteco.com

# Manager dashboard auth
REPORT_USER=billy
REPORT_PASS=change-me

# App
APP_URL=http://localhost:3000
APP_NAME=Haldo
