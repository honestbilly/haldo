  "intro": "Tuesday snorkel inventory. Count all gear — only count complete, working sets. Pull damaged items into the repair bin. Restock from office or foredeck dockbox if below minimum. Flag damaged gear with the (+) note button and a photo.",
  "sections": [
    {
      "title": "Masks & Snorkels",
      "items": [
        {
          "id": "adult-masks",
          "label": "Adult Cressi mask & snorkel (bite tabs working!)",
          "type": "number",
          "min": 14,
          "max": 18,
          "unit": "sets",
          "help": {
            "title": "How to count",
            "body": "Count complete sets only — mask AND snorkel together. Check that bite tabs are intact and flexible. If a bite tab is cracked or stiff, pull that set and put it in the repair bin. Don't count it."
          },
          "alert_below_min": {
            "message": "Adult masks below minimum ({value}/14). Restock from office.",
            "notify": ["manager"],
            "severity": "warning"
          }
        },
        {
          "id": "junior-masks",
          "label": "Junior Cressi mask + adult snorkel (bite tabs working!)",
          "type": "number",
          "min": 8,
          "max": 10,
          "unit": "sets",
          "alert_below_min": {
            "message": "Junior masks below minimum ({value}/8). Restock from office.",
            "notify": ["manager"],
            "severity": "warning"
          }
        },
        {
          "id": "kids-masks",
          "label": "Kid's mask & snorkel (bite tabs working!)",
