{
  "id": "trip-logbook-squid",
  "name": "Trip Logbook",
  "type": "logbook",
  "vessel": "squid",
  "role": "captain",
  "recurrence": "per-trip",
  "version": "2026-03-30",
  "source": "KB: squid-on-board-binder / SFR Spec — Trip Logbook",
  "estimated_minutes": 5,
  "priority": 50,
  "display_order": 30,
  "captain_steps": [1, 2, 3, 4, 5, 6, 7],
  "mate_steps": [],
  "steps": [
    {
      "step": 1,
      "title": "Trip Confirmation",
      "items": [
        {
          "id": "trip-date",
          "label": "Trip date",
          "type": "text",
          "required": true
        },
        {
          "id": "trip-slot",
          "label": "Trip slot",
          "type": "select",
          "options": ["AM", "PM", "Sunset"],
          "required": true
        }
      ]
    },
    {
      "step": 2,
      "title": "Crew Roster",
      "items": [
        {
          "id": "crew-on-board",
          "label": "Crew on board",
          "type": "multi_select",
          "options": ["Jess", "Chase", "Kristen", "Alexa", "Libbie", "Dan", "Andrew", "Hadden", "Bryan", "Jackie", "Charlie"],
          "required": true
        }
      ]
    },
    {
      "step": 3,
      "title": "Passengers",
      "items": [
        {
          "id": "guest-count",
          "label": "Total guest count",
          "type": "number",
          "min": 0,
          "max": 18,
          "unit": "guests",
          "required": true
        },
        {
          "id": "no-shows",
          "label": "No-shows",
          "type": "number",
          "min": 0,
          "max": 18,
          "unit": "guests"
        },
        {
          "id": "waivers-confirmed",
          "label": "All waivers confirmed",
          "type": "checkbox",
          "required": true
        }
      ]
    },
    {
      "step": 4,
      "title": "Safety",
      "items": [
        {
          "id": "safety-orientation",
          "label": "Safety orientation completed (life jackets, fire extinguishers, MOB ring, slips/trips/falls)",
          "type": "checkbox",
          "required": true,
          "help": {
            "title": "Required USCG safety briefing",
            "body": "Must cover: life jackets, fire extinguishers, MOB ring and procedure, when to stay seated (takeoff/landing), keep hands/head inside during docking, slips/trips/falls — how to walk safely (hold on, don't run/jump/climb)."
          }
        },
        {
          "id": "boat-orientation",
          "label": "Boat orientation completed (head, water, snacks, where to go)",
          "type": "checkbox"
        },
        {
          "id": "incident-occurred",
          "label": "Any incidents on this trip?",
          "type": "select",
          "options": ["No incidents", "Minor incident", "Major incident"],
          "info": "Select 'No incidents' if nothing to report."
        },
        {
          "id": "incident-details",
          "label": "Incident details",
          "type": "text",
          "placeholder": "Describe what happened, who was involved, and actions taken...",
          "requires": "incident-occurred",
          "help": {
            "title": "⚠️ USCG Reporting",
            "body": "If this incident involves injury, vessel damage, or a person overboard, the captain MUST contact the U.S. Coast Guard immediately. VHF Channel 16 or call (305) 535-4300."
          }
        }
      ]
    },
    {
      "step": 5,
      "title": "Operations",
      "items": [
        {
          "id": "snorkel-location",
          "label": "Snorkel location",
          "type": "text",
          "placeholder": "Where did you snorkel?"
        },
        {
          "id": "dolphin-location",
          "label": "Dolphin location",
          "type": "text",
          "placeholder": "Where were dolphins spotted?"
        },
        {
          "id": "other-location",
          "label": "Other location (sandbar, etc.)",
          "type": "text",
          "placeholder": "Optional — leave blank if N/A",
          "info": "Only fill in if you visited a location other than snorkel/dolphin spots"
        },
        {
          "id": "engine-hours-end",
          "label": "Engine hours at return",
          "type": "number",
          "unit": "hours"
        },
        {
          "id": "weather-conditions",
          "label": "Weather / sea conditions",
          "type": "text"
        }
      ]
    },
    {
      "step": 6,
      "title": "Notes",
      "items": [
        {
          "id": "trip-highlights",
          "label": "Trip highlights / notable wildlife",
          "type": "text"
        },
        {
          "id": "maintenance-completed",
          "label": "Maintenance completed today",
          "type": "text"
        },
        {
          "id": "issues-notes",
          "label": "Issues, incidents, or notes for next captain",
          "type": "text"
        }
      ]
    },
    {
      "step": 7,
      "title": "Merchandise & Fundraising",
      "prompt": "Merch for Non-Profit Sold:",
      "items": [
        {
          "id": "merch-hat",
          "label": "Hats sold",
          "type": "number",
          "unit": "qty"
        },
        {
          "id": "merch-tshirt",
          "label": "T-Shirts sold",
          "type": "number",
          "unit": "qty"
        },
        {
          "id": "merch-sunshirt",
          "label": "Sun Shirts sold",
          "type": "number",
          "unit": "qty"
        },
        {
          "id": "merch-sweatshirt",
          "label": "Sweatshirts sold",
          "type": "number",
          "unit": "qty"
        },
        {
          "id": "merch-payment",
          "label": "How were items paid for?",
          "type": "multi_select",
          "options": ["Cash", "Card", "Venmo", "Zelle", "Added to tab", "No sales today"]
        },
        {
          "id": "merch-notes",
          "label": "Merch notes",
          "type": "text",
          "info": "Any issues, special requests, or inventory concerns"
        }
      ]
    }
  ],
  "completion": {
    "require_all": false,
    "sign_off": true,
    "notes_field": true,
    "notes_prompt": "Any additional notes for the record?"
  }
}