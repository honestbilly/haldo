        },
        {
          "id": "t1-deckhand-other",
          "label": "Other / relief deckhand",
          "type": "text",
          "placeholder": "Name if not listed above",
          "requires": "t1-has-trip"
        },
        {
          "id": "t1-pax",
          "label": "Passengers on board",
          "type": "number",
          "min": 0,
          "max": 50,
